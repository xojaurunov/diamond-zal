# Shu faylni `.env` deb nusxalab, qiymatni to'ldiring (`.env` git'ga tushmaydi):
#     copy backend\.env.namuna backend\.env
# Mahalliy sinov bazasi paroli (docker-compose.yml va testlar shundan oladi)
BACKEND_DB_PASS=
# Servis tokenlari imzosi uchun tasodifiy uzun satr
JWT_SECRET=
# Saytdan servisga ruxsat etilgan manzillar (vergul bilan); bo'h — standart ro'yxat
# ALLOWED_ORIGINS=
